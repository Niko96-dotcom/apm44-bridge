{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ultimate-de-slop review output",
  "type": "object",
  "required": ["repo_summary", "review_wave_id", "partitions_reviewed", "findings"],
  "properties": {
    "repo_summary": {"type": "string"},
    "review_wave_id": {"type": "string"},
    "partitions_reviewed": {"type": "array", "items": {"type": "string"}},
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["id", "title", "severity", "confidence", "category", "status", "files", "evidence", "why_it_matters", "proposed_fix", "acceptance_criteria", "expected_checks", "expected_checks_explanation", "no_expected_checks_reason", "checks_explanation", "risk", "dependencies", "estimated_effort", "reviewer", "created_at", "updated_at"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "severity": {"enum": ["P0", "P1", "P2", "P3"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "category": {"type": "string"},
        "status": {"type": "string"},
        "files": {"type": "array", "items": {"type": "string"}},
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "lines", "symbol", "claim"],
            "properties": {
              "file": {"type": "string"},
              "lines": {"type": "string"},
              "symbol": {"type": "string"},
              "claim": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "why_it_matters": {"type": "string"},
        "proposed_fix": {"type": "string"},
        "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
        "expected_checks": {"type": "array", "items": {"type": "string"}},
        "expected_checks_explanation": {"type": "string"},
        "no_expected_checks_reason": {"type": "string"},
        "checks_explanation": {"type": "string"},
        "risk": {"enum": ["low", "medium", "high"]},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "estimated_effort": {"enum": ["small", "medium", "large"]},
        "reviewer": {"type": "string"},
        "created_at": {"type": "string"},
        "updated_at": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
